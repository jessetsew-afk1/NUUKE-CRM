# ---- server ----
NODE_ENV=development
PORT=4000

# Postgres. Either give a full URL, or the individual parts below.
DATABASE_URL=postgres://nuuke:nuuke@localhost:5432/nuuke_crm
# Set to "require" when your provider needs TLS (Neon, Supabase, RDS, Render...)
PGSSLMODE=disable

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=12h

# Where the React app is served from, for CORS + cookie settings.
CLIENT_ORIGIN=http://localhost:5173

# Password given to every seeded account. Change it, and change it again after first login.
SEED_PASSWORD=NuukeDemo!2026
