# ---- Browser (safe to expose; row level security protects the data) ----
# Supabase → Project Settings → API (or "API Keys")
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy "anon" key

# ---- Server only (Netlify → Site configuration → Environment variables) ----
# Used by netlify/functions/admin-users to create logins. Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...                    # or the legacy "service_role" key
